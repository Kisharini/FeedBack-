generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String              @id @default(cuid())
  name                         String
  email                        String              @unique
  password                     String
  role                         Role
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  approvalNotes                String?
  approvalStatus               ApprovalStatus      @default(APPROVED)
  approvedAt                   DateTime?
  ngoAddress                   String?
  ngoContactPhone              String?
  ngoDescription               String?
  ngoOrganizationName          String?
  ngoRegistrationNumber        String?
  ngoSsmDocumentPublicId       String?
  ngoSsmDocumentUrl            String?
  ngoSupportingDocPublicIds    String[]
  ngoSupportingDocUrls         String[]
  riderAddress                 String?
  riderLicenseDocumentPublicId String?
  riderLicenseDocumentUrl      String?
  riderLicenseNumber           String?
  riderNotes                   String?
  riderPhoneNumber             String?
  riderVehicleColor            String?
  riderVehicleGrantPublicId    String?
  riderVehicleGrantUrl         String?
  riderVehicleName             String?
  riderVehiclePlateNumber      String?
  riderVehicleType             String?
  vendorBusinessName           String?
  vendorContactPhone           String?
  vendorDescription            String?
  vendorPlaceAddress           String?
  vendorRegistrationNumber     String?
  vendorSsmDocumentPublicId    String?
  vendorSsmDocumentUrl         String?
  walletBalance                Int                 @default(0)
  claimedListings              Listing[]           @relation("ClaimedListings")
  listings                     Listing[]           @relation("VendorListings")
  notifications                notifications[]
  orders                       Order[]             @relation("CustomerOrders")
  riderOrders                  Order[]             @relation("AssignedRiderOrders")
  walletTransactions           WalletTransaction[]

  @@map("users")
}

model Listing {
  id              String        @id @default(cuid())
  title           String
  description     String
  type            ListingType
  quantity        Int
  unitPrice       Int?
  expiryAt        DateTime
  location        String
  pickupLatitude  Float?
  pickupLongitude Float?
  imageUrl        String?
  status          ListingStatus @default(AVAILABLE)
  vendorId        String
  claimedById     String?
  claimedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  claimedBy       User?         @relation("ClaimedListings", fields: [claimedById], references: [id])
  vendor          User          @relation("VendorListings", fields: [vendorId], references: [id])
  orderItems      OrderItem[]

  @@index([type])
  @@index([status])
  @@index([expiryAt])
  @@index([location])
  @@index([vendorId])
  @@index([claimedById])
  @@map("listings")
}

model Order {
  id                 String              @id @default(cuid())
  customerId         String
  riderId            String?
  deliveryOption     DeliveryOption
  paymentMethod      PaymentMethod
  status             OrderStatus
  subtotalAmount     Int
  deliveryFeeAmount  Int
  totalAmount        Int
  deliveryAddress    String?
  deliveryLatitude   Float?
  deliveryLongitude  Float?
  pickupInstructions String?
  riderName          String?
  riderPhoneNumber   String?
  riderVehicle       String?
  riderPlateNumber   String?
  trackingLatitude   Float?
  trackingLongitude  Float?
  trackingMessage    String?
  paidAt             DateTime
  deliveredAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              OrderItem[]
  customer           User                @relation("CustomerOrders", fields: [customerId], references: [id])
  rider              User?               @relation("AssignedRiderOrders", fields: [riderId], references: [id])
  walletTransactions WalletTransaction[]

  @@index([customerId])
  @@index([riderId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id            String      @id @default(cuid())
  orderId       String
  listingId     String
  titleSnapshot String
  listingType   ListingType
  quantity      Int
  unitPrice     Int
  lineTotal     Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  listing       Listing     @relation(fields: [listingId], references: [id])
  order         Order       @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([listingId])
  @@map("order_items")
}

model WalletTransaction {
  id          String                @id @default(cuid())
  userId      String
  orderId     String?
  type        WalletTransactionType
  amount      Int
  description String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  order       Order?                @relation(fields: [orderId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([type])
  @@map("wallet_transactions")
}

model notifications {
  id        String           @id
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime
  users     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isRead])
  @@index([userId])
}

enum Role {
  INDIVIDUAL
  NGO
  VENDOR
  RIDER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  AVAILABLE
  CLAIMED
  PICKED_UP
  DELIVERED
  EXPIRED
}

enum ListingType {
  DISCOUNTED
  DONATION
}

enum DeliveryOption {
  DELIVERY
  SELF_PICKUP
}

enum PaymentMethod {
  FPX
  TOUCH_N_GO
  GRABPAY
  BOOST
  SHOPEEPAY
}

enum OrderStatus {
  PAYMENT_CONFIRMED
  READY_FOR_PICKUP
  FINDING_RIDER
  RIDER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
}

enum WalletTransactionType {
  ORDER_PAYOUT
  WITHDRAWAL
}

enum NotificationType {
  LISTING_ALERT
  CLAIM_ALERT
  PICKUP_REMINDER
  DELIVERY_REMINDER
  STATUS_UPDATE
}
